{
  "name": "manual-kit",
  "version": "0.1.0",
  "description": "Build and maintain formal customer manuals (PDF/DOCX) that stay in sync with the code. No AI inside.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "manual-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "templates"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm check && pnpm bundle && pnpm test && pnpm build",
    "prepare": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle-plugin.mjs"
  },
  "dependencies": {
    "@vue/compiler-dom": "^3.5.43",
    "@xmldom/xmldom": "^0.9.12",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.2",
    "pagedjs": "^0.4.3",
    "playwright": "^1.63.0",
    "qrcode": "^1.5.4",
    "typescript": "5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.3"
  }
}
